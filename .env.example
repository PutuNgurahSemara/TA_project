# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:9b
EMBED_MODEL=bge-m3

# RAG Hyperparameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5

# Admin Credentials
ADMIN_USERNAME=admin
# Jalankan `python setup_admin.py` untuk menghasilkan hash password
ADMIN_PASSWORD_HASH=

# Security & Access Protection (Opsional)
# Jika diisi, pengunjung web harus memasukkan kode ini sekali sebelum bisa chatting.
# Jika dikosongkan, chat terbuka untuk siapa saja (tetap dilindungi rate limiter).
CHAT_ACCESS_KEY=
RATE_LIMIT_CHAT_PER_MINUTE=10

