# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=bge-m3

# RAG Hyperparameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5

# Admin Credentials
ADMIN_USERNAME=admin
# Password hash akan otomatis dibuat default 'admin123' saat pertama kali running,
# atau Anda dapat mengatur password baru via CLI interaktif: `python setup_admin.py`
ADMIN_PASSWORD_HASH=

# Security & Access Protection (Opsional)
# Jika diisi, pengunjung web harus memasukkan kode ini sebelum dapat chatting.
# Jika dikosongkan, chat terbuka langsung untuk siapa saja.
CHAT_ACCESS_KEY=
RATE_LIMIT_CHAT_PER_MINUTE=10

# Deployment
# Domain frontend yang boleh memanggil API (pisahkan dengan koma). Kosong = semua origin.
# Contoh: ALLOWED_ORIGINS=https://ta-chatbot.vercel.app
ALLOWED_ORIGINS=
# 127.0.0.1 = hanya bisa diakses dari PC ini (lewat cloudflared). 0.0.0.0 = terbuka ke jaringan lokal.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# true hanya saat development; reload menghapus semua sesi admin.
DEV_RELOAD=false